# Supabase loyihasi: Dashboard → Project Settings → API (yoki `supabase start` chiqishi)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "anon" yoki yangi "publishable" kalit. Brauzerga ochiq bo'lishi xavfsiz (RLS himoya qiladi).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" yoki yangi "secret" kalit. FAQAT serverda. Hech qachon NEXT_PUBLIC_ qilmang,
# chatga yoki GitHub'ga yozmang.
SUPABASE_SERVICE_ROLE_KEY=

# Faqat DB testlari uchun (oddiy PostgreSQL superuser ulanishi). Supabase lokal: port 54322, parol postgres.
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Demo seed faqat shu qiymat "ha" bo'lsa ishlaydi.
ALLOW_DEMO_SEED=
